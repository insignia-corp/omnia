{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      { "include": "agente/prompts/*.md", "watchAssets": true },
      { "include": "ingestao/extracao/*.md", "watchAssets": true },
      { "include": "ingestao/vinculo/*.md", "watchAssets": true }
    ]
  }
}
