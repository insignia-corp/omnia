# Copie para .env e preencha. Nunca commite o .env (regra inviolável 12).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rodando a API fora do Docker; no compose estes valores são sobrescritos.
DATABASE_URL=postgres://omnia:omnia@localhost:5432/omnia
REDIS_URL=redis://localhost:6379

# Agente
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_ESFORCO=medium
LLM_TIMEOUT_MS=60000
AGENTE_MAX_ITERACOES=8
AGENTE_MAX_REGERACOES=2

# Ingestão: itens abaixo deste limite viram pergunta ao dono
LIMITE_CONFIANCA_ITEM=0.8
# Descrição da nota liga sozinha a um produto acima desta similaridade (0 a 1); abaixo, pergunta ao dono
LIMITE_SIMILARIDADE=0.45
# Modelo com visão que lê a foto da nota
EXTRATOR_MODELO=claude-sonnet-5-5
# Onde ficam as fotos e planilhas enviadas (disco local; trocar por S3 depois)
ARMAZENAMENTO_DIR=./.dados/arquivos
# Tamanho máximo de um upload, em bytes (10 MB)
UPLOAD_MAX_BYTES=10485760

# LGPD: meses de retenção de dados
RETENCAO_MESES=24

# web (chat web, padrão da regional) ou whatsapp
CANAL=web

# Relatório diário: horário (cron), fuso e janela de silêncio em que nada é enviado
FUSO_HORARIO=America/Sao_Paulo
RELATORIO_DIARIO_CRON=0 8 * * *
SILENCIO_INICIO=22:00
SILENCIO_FIM=07:00

# Portas no host para o docker compose (mude se já estiverem em uso)
API_PORTA=3000
POSTGRES_PORTA=5432
REDIS_PORTA=6379
