# Copie para .env e preencha. Nunca commite o .env (regra inviolável 12).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rodando a API fora do Docker; no compose estes valores são sobrescritos.
DATABASE_URL=postgres://omnia:omnia@localhost:5432/omnia
REDIS_URL=redis://localhost:6379

# Agente
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_ESFORCO=medium
LLM_TIMEOUT_MS=60000
AGENTE_MAX_ITERACOES=8
AGENTE_MAX_REGERACOES=2

# Ingestão: itens abaixo deste limite viram pergunta ao dono
LIMITE_CONFIANCA_ITEM=0.8

# LGPD: meses de retenção de dados
RETENCAO_MESES=24

# web (chat web, padrão da regional) ou whatsapp
CANAL=web

# Portas no host para o docker compose (mude se já estiverem em uso)
API_PORTA=3000
POSTGRES_PORTA=5432
REDIS_PORTA=6379
