{
  "name": "omnia",
  "version": "0.1.0",
  "private": true,
  "description": "Gestor automático para pequenos comércios: agente de IA que avisa o dono pelo WhatsApp o que importa no negócio",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "bullmq": "6.3.11",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxes": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jszip": "3.10.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --env-file-if-exists=.env --experimental-vm-modules ./node_modules/jest/bin/jest.js -c jest.e2e.config.js --runInBand",
    "test:web": "node --test web/whatsapp/testes/*.test.mjs",
    "fixtures:gerar": "tsx scripts/fixtures/gerar-tudo.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/database/migrar.ts",
    "db:seed": "tsx src/infra/database/seed/semear.ts",
    "db:reset": "tsx src/infra/database/resetar.ts && tsx src/infra/database/migrar.ts",
    "demo:reset": "tsx scripts/demo/resetar-demo.ts",
    "seed:demo": "npm run db:reset && npm run db:seed",
    "seed:pitch": "tsx scripts/pitch/semear.ts",
    "eval": "tsx src/avaliacao/cli.ts",
    "eval:extracao": "tsx src/avaliacao/extracao/cli.ts",
    "eval:custo": "tsx src/avaliacao/custo/cli.ts"
  }
}
